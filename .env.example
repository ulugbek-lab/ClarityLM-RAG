# Copy to .env and fill in your Qdrant Cloud settings.
QDRANT_URL=https://your-cluster-url:6333
QDRANT_API_KEY=replace-with-your-key
QDRANT_COLLECTION=claritylm_documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
LLM_ADAPTER_PATH=./clarityLM
LLM_DEVICE=cpu
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.2
RAG_ENABLED=true
TOP_K=5
MAX_SOURCES=2
MIN_SCORE=0.25
ENABLE_INGEST_PATH=false
